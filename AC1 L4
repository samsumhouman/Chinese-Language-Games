<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Panda Chinese Games - Family Four Choice</title>
<style>
body {
  margin: 0;
  font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
  background: linear-gradient(#9be7ff, #dff7d8);
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  user-select: none;
}
.sky {
  position: fixed;
  inset: 0;
  background: radial-gradient(circle at 20% 20%, rgba(255,255,255,0.5), transparent 25%);
  pointer-events: none;
}
.wrap {
  width: 100%;
  max-width: 800px;
  margin: 20px;
  position: relative;
}
.panel {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24px;
  padding: 24px;
  backdrop-filter: blur(8px);
  box-shadow: 0 12px 32px rgba(0,0,0,0.12);
}
.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20px;
  font-weight: bold;
  color: #2d6a2f;
  margin-bottom: 12px;
}
.stats {
  display: flex;
  gap: 16px;
}
.stat-box {
  background: #fff;
  padding: 6px 14px;
  border-radius: 16px;
  border: 2px solid #b2e2a2;
}
#mode-select {
  font-size: 16px;
  padding: 6px 12px;
  border-radius: 12px;
  border: 2px solid #b2e2a2;
  outline: none;
  background: #fff;
  cursor: pointer;
}
#prompt {
  text-align: center;
  font-size: 42px;
  font-weight: bold;
  color: #1a4d1c;
  margin: 20px 0 10px;
  min-height: 56px;
}
#sub-prompt {
  text-align: center;
  font-size: 18px;
  color: #666;
  margin-bottom: 20px;
  min-height: 24px;
}
#combo {
  text-align: center;
  font-size: 24px;
  font-weight: bold;
  color: #ff6b00;
  height: 30px;
}
#grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin-top: 10px;
}
.card {
  background: #fff;
  border-radius: 18px;
  padding: 20px;
  text-align: center;
  cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s;
  border: 3px solid #e6e6e6;
  box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}
.card:hover {
  transform: translateY(-4px);
  border-color: #82c973;
}
.card.correct {
  background: #c8ffd2 !important;
  border-color: #28a745 !important;
  box-shadow: 0 0 20px #7cff91;
}
.card.wrong {
  background: #f8d7da !important;
  border-color: #dc3545 !important;
  animation: shake 0.3s ease-in-out;
}
.h { font-size: 34px; font-weight: bold; color: #2d3748; }
.p { font-size: 20px; color: #2b6cb0; margin-top: 4px; }

#panda {
  font-size: 72px;
  text-align: center;
  margin-top: 15px;
  transition: transform 0.3s;
}

.star {
  position: fixed;
  font-size: 26px;
  pointer-events: none;
  animation: fly 0.9s linear forwards;
}
@keyframes fly {
  0% { opacity: 1; transform: translate(0, 0) scale(0.8); }
  100% { opacity: 0; transform: translate(0, -100px) scale(1.6); }
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8px); }
  75% { transform: translateX(8px); }
}

.end-screen {
  text-align: center;
  padding: 20px;
}
.btn-restart {
  font-size: 20px;
  font-weight: bold;
  color: #fff;
  background: #4caf50;
  border: none;
  padding: 10px 30px;
  border-radius: 25px;
  cursor: pointer;
  box-shadow: 0 5px 0 #388e3c;
}
.btn-restart:active {
  transform: translateY(3px);
  box-shadow: 0 2px 0 #388e3c;
}

@media (max-width: 500px) {
  #grid { grid-template-columns: 1fr; }
  .h { font-size: 28px; }
  #prompt { font-size: 32px; }
}
</style>
</head>
<body>
<div class="sky"></div>
<div class="wrap">
  <div class="panel" id="app"></div>
</div>

<script>
const words = [
  { h: "大家", p: "dà jiā" },
  { h: "家", p: "jiā" },
  { h: "有", p: "yǒu" },
  { h: "口", p: "kǒu" },
  { h: "人", p: "rén" },
  { h: "爸爸", p: "bà ba" },
  { h: "妈妈", p: "mā ma" },
  { h: "哥哥", p: "gē ge" },
  { h: "姐姐", p: "jiě jie" },
  { h: "弟弟", p: "dì di" },
  { h: "妹妹", p: "mèi mei" },
  { h: "没有", p: "méi yǒu" },
  { h: "和", p: "hé" },
  { h: "谁", p: "shéi" },
  { h: "家人", p: "jiā rén" },
  { h: "这", p: "zhè" }
];

let score = 0, combo = 0, time = 60, mode = "p2h", target = null, timerId = null, lock = false;

const sh = a => [...a].sort(() => Math.random() - 0.5);

function say(txt) {
  if ('speechSynthesis' in window) {
    window.speechSynthesis.cancel();
    let u = new SpeechSynthesisUtterance(txt);
    u.lang = 'zh-CN';
    u.rate = 0.9;
    window.speechSynthesis.speak(u);
  }
}

function particle(x, y) {
  for (let i = 0; i < 8; i++) {
    let s = document.createElement('div');
    s.className = 'star';
    s.textContent = '⭐';
    s.style.left = (x + (Math.random() - 0.5) * 40) + 'px';
    s.style.top = y + 'px';
    document.body.appendChild(s);
    setTimeout(() => s.remove(), 900);
  }
}

function startTimer() {
  if (timerId) clearInterval(timerId);
  timerId = setInterval(() => {
    time--;
    const tmEl = document.getElementById('tm');
    if (tmEl) tmEl.textContent = time;
    if (time <= 0) gameOver();
  }, 1000);
}

function gameOver() {
  clearInterval(timerId);
  const app = document.getElementById('app');
  app.innerHTML = `
    <div class="end-screen">
      <h1 style="font-size:36px; color:#2d6a2f;">⏰ 时间到！</h1>
      <h2 style="font-size:26px; color:#4a7c44;">最终得分：⭐ ${score} 分</h2>
      <p style="font-size:18px; color:#666;">🐼 太棒了！你练习了家庭主题词汇！</p>
      <button class="btn-restart" onclick="restartGame()">再玩一次</button>
    </div>
  `;
}

function restartGame() {
  score = 0;
  combo = 0;
  time = 60;
  lock = false;
  render();
  startTimer();
}

function render() {
  if (time <= 0) return;
  lock = false;
  target = words[Math.floor(Math.random() * words.length)];
  let opts = sh(words.filter(w => w !== target)).slice(0, 3);
  opts.push(target);
  opts = sh(opts);

  const app = document.getElementById('app');
  app.innerHTML = `
    <div class="top">
      <div class="stats">
        <div class="stat-box">⭐ <span id="sc">${score}</span></div>
        <div class="stat-box">⏰ <span id="tm">${time}</span>s</div>
      </div>
      <div>
        <select id="mode-select">
          <option value="p2h">拼音 ➔ 汉字</option>
          <option value="h2p">汉字 ➔ 拼音</option>
        </select>
      </div>
    </div>
    <div id="combo">${combo >= 2 ? "🔥 Combo x" + combo : ""}</div>
    <div id="prompt">${mode === "p2h" ? target.p : target.h}</div>
    <div id="sub-prompt">${mode === "p2h" ? "请选择正确的汉字" : "请选择正确的拼音"}</div>
    <div id="grid"></div>
    <div id="panda">🐼🎋</div>
  `;

  const sel = document.getElementById('mode-select');
  sel.value = mode;
  sel.onchange = (e) => {
    mode = e.target.value;
    render();
  };

  const grid = document.getElementById('grid');
  opts.forEach(o => {
    let card = document.createElement('div');
    card.className = 'card';
    card.innerHTML = mode === "p2h" 
      ? `<div class="h">${o.h}</div>` 
      : `<div class="p">${o.p}</div>`;

    card.onclick = (ev) => {
      if (lock) return;
      if (o === target) {
        lock = true;
        score += 10;
        combo++;
        card.classList.add('correct');
        say(target.h);
        particle(ev.clientX, ev.clientY);
        document.getElementById('panda').textContent = '🐼🎉';
        setTimeout(() => {
          render();
        }, 600);
      } else {
        combo = 0;
        score = Math.max(0, score - 2);
        card.classList.add('wrong');
        document.getElementById('sc').textContent = score;
        document.getElementById('combo').textContent = '';
        document.getElementById('panda').textContent = '🐼❌';
        setTimeout(() => {
          card.classList.remove('wrong');
          document.getElementById('panda').textContent = '🐼🎋';
        }, 500);
      }
    };
    grid.appendChild(card);
  });
}

window.onload = () => {
  render();
  startTimer();
};
</script>
</body>
</html>
